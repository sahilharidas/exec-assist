# Copy to .env and fill in. Never commit .env.

# Directory that contains the Obsidian vault folder, and the vault folder's name.
EA_VAULT_ROOT=/path/to/synced/notes
EA_VAULT_NAME=Notes
EA_TZ=Africa/Johannesburg

# uid/gid the MCP container runs as (match the user that runs the cron jobs).
EA_UID=1000
EA_GID=1000

# Telegram: the agent's bot token (send-only use here) and your own chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_HOME_CHANNEL=

# Only for the standalone bot in bin/ea-bot.py: it needs a bot of its own.
EA_TELEGRAM_BOT_TOKEN=

# Weekly review and the standalone bot's rewrites.
OPENROUTER_API_KEY=
